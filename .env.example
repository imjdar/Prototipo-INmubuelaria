# ==============================================================================
# PROPIEDADES PREMIER - ARCHIVO DE CONFIGURACIÓN DE ENTORNO (.env.example)
# Copia este archivo como .env en tu servidor de producción y asigna valores reales.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configuración General del Servidor
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=4000

# ------------------------------------------------------------------------------
# 2. Ciberseguridad & Criptografía (OWASP Top 10)
# ¡IMPORTANTE!: Genera una clave aleatoria de al menos 64 caracteres en producción
# Comando sugerido: openssl rand -base64 48
# ------------------------------------------------------------------------------
JWT_SECRET=reemplazar_con_clave_secreta_criptografica_de_alta_entropia_para_produccion_2026
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7
BCRYPT_SALT_ROUNDS=12

# ------------------------------------------------------------------------------
# 3. Política de Orígenes Permitidos (CORS)
# Separar múltiples dominios con comas sin espacios
# ------------------------------------------------------------------------------
CORS_ORIGIN=https://propiedadespremier.ec,https://www.propiedadespremier.ec,http://localhost

# ------------------------------------------------------------------------------
# 4. Base de Datos SQLite (WAL Mode con Transacciones ACID)
# Ruta absoluta dentro del contenedor Docker o relativa en ejecución local
# ------------------------------------------------------------------------------
DATABASE_PATH=/app/database/premier.db

# ------------------------------------------------------------------------------
# 5. Puertos de Exposición Docker
# ------------------------------------------------------------------------------
FRONTEND_PORT=80
BACKEND_PORT=4000
